# ==============================================================================
# CAMBODIA CPI PIPELINE ENVIRONMENT CONFIGURATION
# Copy to .env and fill in BEFORE `docker compose up -d`.
# Values marked (REQUIRED) make `docker compose config` fail if missing.
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================

# ── Airflow Cryptographic Secrets (REQUIRED) ──────────────────────────────────
# These protect stored Connections/Variables and sign session cookies.
# NEVER commit real values; rotate any that have ever been exposed.
AIRFLOW__CORE__FERNET_KEY=replace-with-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-long-random-string

# ── Airflow Admin Bootstrap (REQUIRED) ────────────────────────────────────────
# Used once by airflow-init to create the UI admin account. Change from defaults!
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-strong-password

# PostgreSQL Warehouse Connection (Application & dbt)
DB_HOST=postgres
DB_PORT=5432
DB_USER=cpi_user
DB_PASS=cpi_pass
DB_NAME=cpi_db

# PostgreSQL Superuser / Init Settings
# NOTE: keep POSTGRES_USER=postgres / POSTGRES_DB=postgres so that
# postgres-init/01-init.sql can create cpi_user/cpi_db itself; setting these to
# cpi_user/cpi_db breaks first boot (role already exists -> init aborts).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# Airflow Infrastructure Configuration
AIRFLOW_IMAGE_NAME=cpi-airflow:2.9.3-simple
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# dbt Profiles Location
DBT_PROFILES_DIR=/opt/airflow/dbt

# Metabase Analytics UI
METABASE_PORT=3000
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_PORT=5432
MB_DB_USER=metabase
MB_DB_PASS=metabase
MB_DB_HOST=postgres

# Scraper Settings
AEON_MAX_PAGES=0

# Scraper API Keys / Tokens (optional — scrapers degrade to flagged baselines)
# Multi-Key Pool: comma-separated free Gemini keys for increased quota & automatic 429 failover
GEMINI_API_KEYS=key1,key2,key3,key4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_PRODUCTS_PER_RUN=500
USE_LOCAL_FALLBACK_FIRST=true
PHARMA_SUPABASE_ANON_KEY=
VIREAKBUNTHAM_BEARER_TOKEN=

# Pipeline Constants
BASE_PERIOD=2026-08
DEFAULT_USD_KHR_RATE=4044
CPI_COLD_STORAGE_DIR=/opt/airflow/data/cold_storage

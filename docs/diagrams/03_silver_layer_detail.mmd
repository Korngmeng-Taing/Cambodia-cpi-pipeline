flowchart TD
    %% Global Styling
    classDef whiteBox fill:#FFFFFF,stroke:#0284C7,stroke-width:1.5px,color:#0F172A;
    classDef hygieneBox fill:#FFFFFF,stroke:#2563EB,stroke-width:1.5px,color:#0F172A;
    classDef coicopBox fill:#FFFFFF,stroke:#D97706,stroke-width:1.5px,color:#0F172A;
    classDef finalTable fill:#FFFFFF,stroke:#16A34A,stroke-width:2px,color:#0F172A;
    classDef opsBox fill:#FFFFFF,stroke:#EA580C,stroke-width:1.5px,color:#0F172A;

    subgraph Stage0["Stage 0: Incremental Item Matching (pipeline/vector_item_matcher.py)"]
        B0["Raw Observation from Bronze (bronze.raw_prices)"] --> B1{"Is (store_slug, raw_sku)\nin item_match_log?"}
        B1 -- "YES (Fast Path)" --> B2["Instant Cache Lookup (<0.1ms)\nAuto-inherits Canonical UUID & COICOP"]
        B1 -- "NO (New Observation)" --> B3{"5-Step Matching Ladder"}
        
        B3 --> B4["1. Exact Barcode / SKU Match (conf = 1.0)"]
        B3 --> B5["2. Normalized Exact Text Match (conf = 1.0)"]
        B3 --> B6["3. RapidFuzz + Spec Guards (RAM, Storage, Pack)"]
        B3 --> B7["4. 768-dim Vector Cosine Similarity"]
        
        B7 --> B8{"Similarity Threshold"}
        B8 -- "Score >= 0.88" --> B9["APPROVE_MATCH (Map to UUID)"]
        B8 -- "0.75 <= Score < 0.88" --> B10["silver.needs_review\n(Gemini Pro/Flash Arbitrator)"]
        B8 -- "Score < 0.75" --> B11["SPLIT_NEW\n(Create silver.canonical_items)"]
    end

    subgraph Stage1["Stage 1: Ingestion Hygiene (staging.int_prices_cleaned)"]
        H1["Joined Observations + MEF Daily FX Rate"] --> H2["• USD to KHR Conversion (MEF daily rate, fallback 4044)\n• Khmer Digits Translation (0-9)\n• HTML Decode & Promo Buzzword Stripping\n• Size & Unit Regex Parsing (g, kg, ml, L, pack)\n• Derived unit_price_khr (price_khr / size_value)\n• Promo Clamping (0% to 95%) & Outlier Flags (>100M KHR)"]
    end

    subgraph Stage2["Stage 2: 4-Tier Hybrid COICOP Ladder (staging.int_coicop_classified)"]
        C0["Unclassified / Changed Items"] --> C1{"Resolution Ladder"}
        C1 -- "Tier 1" --> C2["Human Authority Overrides (coicop_override.csv, conf = 1.000)"]
        C1 -- "Tier 2" --> C3["15 Pure Store Domain Locks (Gas->07, Telecom->08, conf = 0.850)"]
        C1 -- "Tier 3" --> C4["768-dim Vector Embeddings vs 12 UN Spaces (conf = 0.80-0.95)"]
        C1 -- "Tier 4" --> C5["Gemini Pro/Flash 3-Key Pool + dim_coicop_ai_cache"]
        C1 -- "Tier 5" --> C6["Store Category Native Mapping (coicop_category_map, conf = 0.900)"]
        C1 -- "Tier 6" --> C7["Store Defaults & UNCLASSIFIED Triage (conf = 0.800)"]
    end

    subgraph Stage3["Stage 3: Hedonics & Final Assembly (silver.clean_store_prices)"]
        H2 & C2 & C3 & C4 & C5 & C6 & C7 & B2 & B9 & B10 & B11 --> M1["Semi-log OLS Hedonic Adjustment\n(Div 08/09 Hardware: silver.hedonic_adjusted_prices)"]
        M1 --> M2["Strict C2 Zero-Price Gate (WHERE price_khr > 0)"]
        M2 --> M3[("silver.clean_store_prices\nUnified Conformed Store-Level Facts\nPK: raw_price_id | FK: item_id, store_slug")]
    end

    class B0,B1,B2,B3,B4,B5,B6,B7,B8,B9,B10,B11 whiteBox;
    class H1,H2 hygieneBox;
    class C0,C1,C2,C3,C4,C5,C6,C7 coicopBox;
    class M1,M2,M3 finalTable;
